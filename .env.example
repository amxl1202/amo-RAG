# ============================================================
# amo-RAG 环境变量
#   cp .env.example .env 之后填两项必填即可
#   .env 已在 .gitignore 里，不会被提交
# ============================================================

# ---------- 必填 ----------
# 通义千问（DashScope）的 Key：生成与向量化都靠它
# 没有 Key 时服务能起，但 /api/qa 与 /vectorize 会失败
DASHSCOPE_API_KEY=

# 访问令牌签名密钥：**至少 32 字节**，不够会启动失败（见 JwtTokenProvider）
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ---------- 数据库（默认值够用）----------
# dev-db.sh 起的容器把 5433 映射到容器内 5432
DB_URL=jdbc:postgresql://localhost:5433/rag_kb
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ---------- 模型（默认值够用）----------
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
# 走专属实例时填完整地址；留空则用 SDK 默认域名
CHAT_ENDPOINT=
EMBEDDING_ENDPOINT=

# ---------- 可选：行为开关 ----------
# 上传文件的落盘目录（默认 ./data/files）
STORAGE_ROOT=./data/files
# 关键词通道模式：ILIKE / TRGM（默认 TRGM）
KEYWORD_MODE=TRGM
# 访问令牌有效期（分钟）与刷新令牌（天）
JWT_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7
# 生产（https）必须置 true，否则刷新 cookie 会被浏览器丢弃
JWT_COOKIE_SECURE=false

# ---------- 可选：检索与生成阈值 ----------
# 这两个数是 59 条评估集校准出来的，改之前先读 docs/eval-baseline.md 第二节
GENERATION_MIN_VECTOR_SIMILARITY=0.35
GENERATION_MIN_KEYWORD_COVERAGE=0.5
# 送进模型的材料预算
GENERATION_MAX_EVIDENCE=6
GENERATION_MAX_CONTEXT_TOKENS=2400

# ---------- 可选：切片参数 ----------
# 改这里必须重跑评估：切片边界一变，所有检索指标都要重测
CHUNK_TARGET_TOKENS=300
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=48

# ---------- 可选：成本画像价格（元 / 千 token）----------
# 模型调价只改这里，不碰代码
METRICS_INPUT_PRICE=0.0008
METRICS_OUTPUT_PRICE=0.002

# ---------- 可选：启动恢复 ----------
# 开机时把"停在中间态超过 N 分钟"的文档重新入队
INGEST_RECOVER_MINUTES=5

# ---------- 可选：超时与重试（一般不用改）----------
# 生成侧
CHAT_TEMPERATURE=0.2
CHAT_MAX_TOKENS=800
CHAT_TIMEOUT_SECONDS=60
CHAT_MAX_ATTEMPTS=3
# 向量化侧：批量大小受接口限制，调大不会更快
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_ATTEMPTS=3
# 检索单通道超时：超时就降级为空列表，另一路照常用
RETRIEVAL_TIMEOUT_MS=800
# JWT 签发方标识，换域名时改
JWT_ISSUER=amo-rag
